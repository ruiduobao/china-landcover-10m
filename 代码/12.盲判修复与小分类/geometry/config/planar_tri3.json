    "year": 2023,
    "features": 64,
    "n_train_limit": 20000,
    "train_window_expand_deg": 2.0,
    "sampler": "randomColumn('rc', seed).sort('rc').limit(20000)",
    "rf": {"numberOfTrees": 100, "minLeafPopulation": 2, "maxNodes": 5000},
    "class_map": "24 类紧凑码空间（第二轮池实际 23 类，缺类 8）"
  },

  "seeds": [7, 11, 23],
  "deadline_s": 1200.0,
